{
  "name": "@os-emails/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "API REST (Express) do sistema de OS e e-mails, com suporte a SQLite e Postgres.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "seed": "tsx src/seed.ts",
    "db:clear": "tsx src/scripts/clear.ts",
    "hash": "tsx src/scripts/hash.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --import tsx src/tests/*.test.ts"
  },
  "dependencies": {
    "express": "^5.1.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
